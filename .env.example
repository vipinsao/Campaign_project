# Copy to .env and adjust. Every variable is documented; none carries a real value.
#
# `npm run dev` sets DATABASE_URL itself (it boots a PostgreSQL child process), so
# for local development you usually need none of this.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://campaign:campaign@127.0.0.1:55432/postgres

# ── Sending ─────────────────────────────────────────────────────────────────
# off  — refuse to send, and refuse BEFORE claiming a queue row (I2). The default,
#        everywhere, deliberately: a fresh clone, a CI run and a developer laptop
#        must all decline to contact anybody.
# mock — write to the mock outbox and fire simulated receipts back. What the demo uses.
# live — actually call the provider.
SEND_MODE=off

# Used to build unsubscribe and tracking URLs. Getting this wrong produces links
# that resolve nowhere, which is the failure I7 exists to catch.
PUBLIC_BASE_URL=http://localhost:3000

# ── Queue and worker ────────────────────────────────────────────────────────
WORKER_ID=worker-1
QUEUE_BATCH_SIZE=100
MAX_ATTEMPTS=5
# Rows stuck in `processing` longer than this are reclaimed, not abandoned.
STALE_CLAIM_MINUTES=15

# ── Trigger safety ──────────────────────────────────────────────────────────
# ISO instant. Nothing whose anchor predates this may ever enrol.
# UNSET MEANS THE TIME-TRIGGER JOB DOES NOTHING AT ALL — an unset floor is an
# unconfigured system, not an unrestricted one. This is what stops a first deploy
# from mailing four years of order history.
TRIGGER_FLOOR_AT=
# Above this many candidates in one run, enrol NOBODY and log the list.
MAX_ENROLMENTS_PER_RUN=500
# Evaluate everything, write every decision row, queue nothing.
TRIGGER_DRY_RUN=false
# Delivery-anchored messages waiting longer than this are cancelled rather than
# parked forever. Unbounded pending state is a leak.
DELIVERY_ANCHOR_MAX_WAIT_DAYS=60

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
# AES-256-GCM key for provider credentials at rest. openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI layer (optional; the system is fully functional with it off) ─────────
FEATURE_AI=false
ANTHROPIC_API_KEY=
# Below this, a classification is routed to human review rather than assigned a
# best-guess label.
CONFIDENCE_THRESHOLD=0.75
# An autonomous system does not email customers until somebody decides it should.
AUTO_SEND=false

# ── Real providers (not needed for the demo) ────────────────────────────────
SMTP_URL=
POSTMARK_SERVER_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
