# Copy to .env and adjust. Every variable is documented; none carries a real value.
#
# `npm run dev` sets DATABASE_URL itself (it boots a PostgreSQL child process), so
# for local development you usually need none of this.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://campaign:campaign@127.0.0.1:55432/postgres

# ── Sending ─────────────────────────────────────────────────────────────────
# off  — refuse to send, and refuse BEFORE claiming a queue row (I2). The default,
#        everywhere, deliberately: a fresh clone, a CI run and a developer laptop
#        must all decline to contact anybody.
# mock — write to the mock outbox and fire simulated receipts back. What the demo uses.
# live — actually call the provider.
SEND_MODE=off

# Used to build unsubscribe and tracking URLs. Getting this wrong produces links
# that resolve nowhere, which is the failure I7 exists to catch.
PUBLIC_BASE_URL=http://localhost:3000

# ── Queue and worker ────────────────────────────────────────────────────────
WORKER_ID=worker-1
QUEUE_BATCH_SIZE=100
MAX_ATTEMPTS=5
# Rows stuck in `processing` longer than this are reclaimed, not abandoned.
STALE_CLAIM_MINUTES=15

# ── Trigger safety ──────────────────────────────────────────────────────────
# ISO instant. Nothing whose anchor predates this may ever enrol.
# UNSET MEANS THE TIME-TRIGGER JOB DOES NOTHING AT ALL — an unset floor is an
# unconfigured system, not an unrestricted one. This is what stops a first deploy
# from mailing four years of order history.
TRIGGER_FLOOR_AT=
# Above this many candidates in one run, enrol NOBODY and log the list.
MAX_ENROLMENTS_PER_RUN=500
# Evaluate everything, write every decision row, queue nothing.
TRIGGER_DRY_RUN=false
# Delivery-anchored messages waiting longer than this are cancelled rather than
# parked forever. Unbounded pending state is a leak.
DELIVERY_ANCHOR_MAX_WAIT_DAYS=60

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
# AES-256-GCM key for provider credentials at rest. openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI layer (optional; the system is fully functional with it off) ─────────
FEATURE_AI=false
ANTHROPIC_API_KEY=
# Below this, a classification is routed to human review rather than assigned a
# best-guess label.
CONFIDENCE_THRESHOLD=0.75
# An autonomous system does not email customers until somebody decides it should.
AUTO_SEND=false

# ── Real providers (not needed for the demo) ────────────────────────────────
# Only read when SEND_MODE=live. Resolving the `mock` provider never touches any
# of these, which is what keeps a clean clone credential-free.
#
# These names are what packages/providers/src/*.ts actually reads. An earlier
# version of this file listed SMTP_URL and TWILIO_FROM_NUMBER, neither of which
# exists in the code - setting them would have failed with "SMTP is not
# configured" and no clue why.

# EMAIL over SMTP (nodemailer). Works with any SMTP provider.
#   Brevo:  smtp-relay.brevo.com : 587   - 300 emails/day, free forever, no card
#   Gmail:  smtp.gmail.com       : 587   - needs 2FA + an App Password, 500/day
#   Resend: smtp.resend.com      : 587   - 3,000/month
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The envelope sender. Must be an address the provider has authorised for you.
SMTP_FROM=
# Implicit TLS is port 465; anything else negotiates STARTTLS. Derived from the
# port when unset, so nobody sets 465 and quietly speaks plaintext to it.
SMTP_SECURE=

# EMAIL over Postmark's HTTP API, as an alternative to SMTP. Both are required:
# the token alone resolves no sender.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=

# SMS over Twilio.
#
# READ THIS BEFORE TRYING TO SEND SMS TO AN INDIAN NUMBER. India's TRAI
# regulations require every commercial A2P sender ID and message template to be
# registered on a DLT (Distributed Ledger Technology) platform, which requires a
# registered business entity. Without it, messages to +91 numbers are rejected by
# the carrier no matter which provider you use - this is a regulatory limit, not a
# Twilio one. A trial account additionally can only reach numbers you have
# verified.
#
# For a demo from India, use the WhatsApp sandbox instead (TWILIO_FROM =
# 'whatsapp:+14155238886'): it is free, needs no DLT, and delivers to Indian
# numbers immediately once you join the sandbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# The sandbox join phrase, WITHOUT the word 'join' - e.g. 'amber-tiger'.
#
# Not used to send anything. It is rendered on the storefront so a visitor is told
# to opt in BEFORE they place the order, instead of discovering afterwards that
# Twilio rejected the message with 63016. The sandbox will not deliver to a number
# that has not joined it, and a demo that does not say so fails silently for every
# visitor.
TWILIO_WHATSAPP_JOIN_CODE=

# Where Twilio should post delivery receipts. Optional; without it a message
# reaches 'sent' and never 'delivered', because delivered_at is written only by a
# provider receipt (I9) and is never inferred from a successful send.
TWILIO_STATUS_CALLBACK_URL=

# ── The public storefront ───────────────────────────────────────────────────
# packages/api/src/routes/storefront.ts - the unauthenticated checkout at /shop.
# It is the only public route that can cause a real message to be sent, so every
# variable here is a limit rather than a feature.

# Which tenant and store orders are written to. Resolved by NAME, because a
# hardcoded tenant UUID is the thing a reviewer greps for first and
# tests/unit/architecture.test.ts fails the build over one.
STOREFRONT_TENANT_NAME=Demo Store (seeded data)
STOREFRONT_STORE_CODE=main

# Live sends per rolling 24 hours, across the whole deployment, counted from
# message_queue.sent_at rather than from a counter in memory - a budget that resets
# on every deploy is not a budget. Set it BELOW your provider's own free limit
# (Brevo gives 300/day), because an account suspended for abuse takes the demo down
# permanently and a budget that stops sending at 21:00 does not.
STOREFRONT_DAILY_SEND_BUDGET=250

# Minimum gap between two orders from the same email address. The per-IP rate limit
# is upstream in app.ts; this is what stops one mailbox being targeted from a
# rotating address pool.
STOREFRONT_ADDRESS_COOLDOWN_SECONDS=60

# ── Mock provider realism ───────────────────────────────────────────────────
# The mock provider models a real channel: ~2% hard failures, ~5% bounces, ~1%
# complaints. That is correct for the seeded dataset, whose whole point is that the
# analytics screens have bounces in them.
#
# It is wrong for a PUBLIC demo. A stranger who places one order and lands on the
# 5% branch concludes the project is broken, and from where they are standing a
# bounce and a bug look identical. A deployment that hands its URL to strangers
# sets these to 0; the seed script's realism is unaffected because it runs against
# its own process.
MOCK_FAILURE_RATE=
MOCK_BOUNCE_RATE=
MOCK_COMPLAINT_RATE=
# How long after acceptance the simulated delivery receipt fires. Two seconds by
# default, which is long enough to watch a row move from 'sent' to 'delivered'.
MOCK_WEBHOOK_DELAY_MS=
